# ---------------------------------------------------------------------------
# Derived data - regenerated by the scripts, so not committed
# ---------------------------------------------------------------------------
# 01_prepare_corpus.py rebuilds this from data/raw on every run.
# data/raw IS committed: it is the provided dataset and cannot be recreated.
data/corpus/

# Report/figures/ is committed (it is a deliverable). The custom-dictionary
# figure set is a near-duplicate and is regenerated by:
#   python scripts/04_inspect_textgrids.py --textgrid-dir outputs_custom_dict \
#       --out-dir Report/figures_custom_dict
Report/figures_custom_dict/

# ---------------------------------------------------------------------------
# Downloaded MFA models and scratch space
# ---------------------------------------------------------------------------
# MFA keeps models in ~/Documents/MFA by default; these patterns only matter if
# a model store or scratch directory is ever pointed inside the repository.
pretrained_models/
mfa_temp/
*.dict.zip
english_us_arpa.zip
english_mfa.zip

# The merged custom dictionary is generated by
# scripts/05_build_custom_dictionary.py. It is not committed: it is ~5.7 MB and
# 99.99% a verbatim copy of the downloadable english_us_arpa dictionary. The 13
# genuinely new lines live in dictionaries/g2p_oov_only.dict.
dictionaries/english_us_arpa_plus_g2p.dict

